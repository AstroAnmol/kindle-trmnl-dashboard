# ==============================================================================
# kindle-trmnl-dashboard Configuration
# Hardware Profile: Kindle WP63GW (Kindle 7th Gen Basic - 800x600 Landscape)
# ==============================================================================

# Server Network Settings
PORT=5055
HOST=0.0.0.0

# E-Ink Refresh Interval (reported to Kindle via 'Refresh-Rate' header)
# Common values: 900 (15 minutes), 1800 (30 minutes), 3600 (1 hour)
REFRESH_RATE_SECONDS=900

# Screen Dimensions & Orientation
# Kindle WP63GW (7th Gen Basic / KT2) Native Landscape: 800x600
# Paperwhite 3/4 / Voyage / Oasis 1: 1448x1072 (landscape) or 1072x1448
# Paperwhite 5 / Oasis 2/3: 1680x1264 (landscape) or 1264x1680
# TRMNL: 800x480
KINDLE_SCREEN_WIDTH=600
KINDLE_SCREEN_HEIGHT=800
SCREEN_ORIENTATION=0

# Image Output Pipeline
# IMAGE_FORMAT: 'png' or 'bmp'
IMAGE_FORMAT=png

# COLOR_MODE: '1bit' (monochrome bilevel) or '8bit' (grayscale)
COLOR_MODE=1bit

# DITHERING: 'true' (Floyd-Steinberg dithering) or 'false' (clean thresholding)
DITHERING=true

# Timezone (Standard IANA format, e.g., 'America/New_York', 'Europe/London')
TIMEZONE=America/New_York

# Google Calendar Feeds
# Comma-separated list of private iCal URLs (ending in .ics)
# Example: https://calendar.google.com/calendar/ical/.../basic.ics,https://...
ICAL_URLS=

# Weather Configuration (Open-Meteo - No API Key Required)
# Coordinates for Atlanta, GA
LATITUDE=33.7490
LONGITUDE=-84.3880
LOCATION_NAME=Atlanta
# CELSIUS: true for °C (default), false for °F
CELSIUS=true

# Tasks / Notes Integration (Local File)
TASKS_FILE_PATH=config/tasks.md

# Optional: Google Keep Integration
# Generates task checklist from a Google Keep note matching GOOGLE_KEEP_NOTE_TITLE
GOOGLE_KEEP_EMAIL=
# Use a Google App Password (https://myaccount.google.com/apppasswords) or master token
GOOGLE_KEEP_PASSWORD=
GOOGLE_KEEP_NOTE_TITLE="Kindle Tasks"

# Optional: Google Tasks OAuth / API credentials file
GOOGLE_TASKS_CREDENTIALS_FILE=
GOOGLE_TASKS_LIST_ID=

# Security / Device Authentication
# Comma-separated list of authorized Kindle MAC addresses or access tokens
# Leave empty to allow any connected device
ALLOWED_DEVICE_IDS=

# Rendering Cache TTL (in seconds)
CACHE_TTL_SECONDS=60